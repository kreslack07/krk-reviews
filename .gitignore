# with HTTP 200 + valid PK\x03\x04 ZIP magic, downloadable by anyone with no purchase.
# Canonical copies live in AppData\Local\hermes\autonomous\deliverables\<slug>\<slug>.zip
gumroad-deliverables/*.zip
*.bak
